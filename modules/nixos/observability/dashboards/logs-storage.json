            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (source) (bytes_rate({host=~\"$host\"} | label_format source=\"{{ if .container }}{{ .container }}{{ else if eq .transport \\\"kernel\\\" }}kernel{{ else if .unit }}{{ .unit }}{{ else }}other{{ end }}\" [$__auto]))",
          "legendFormat": "{{source}}"
