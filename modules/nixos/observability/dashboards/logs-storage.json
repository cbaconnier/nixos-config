{
  "uid": "logs-storage",
  "title": "Log storage",
  "tags": [
    "loki",
    "logs"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "description": "Raw (uncompressed) log bytes per source. Disk use is roughly raw / compression ratio. The top row and the retention, current size and oldest-metric panels ignore the time picker.",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "host",
          "refId": "v",
          "stream": "",
          "type": 1
        },
        "definition": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Retention",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(max by (retention_hours) (loki_distributor_bytes_received_total{is_internal_stream=\"false\"}), \"label\", \"$1 h\", \"retention_hours\", \"(.*)\"), \"label\", \"24 h (1 j)\", \"retention_hours\", \"24\"), \"label\", \"168 h (7 j)\", \"retention_hours\", \"168\"), \"label\", \"336 h (14 j)\", \"retention_hours\", \"336\"), \"label\", \"720 h (30 j)\", \"retention_hours\", \"720\"), \"label\", \"1440 h (60 j)\", \"retention_hours\", \"1440\"), \"label\", \"2160 h (90 j)\", \"retention_hours\", \"2160\"), \"label\", \"4320 h (180 j)\", \"retention_hours\", \"4320\"), \"label\", \"8760 h (365 j)\", \"retention_hours\", \"8760\")",
          "legendFormat": "{{label}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ingested over range",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(bytes_over_time({host=~\"$host\"} | label_format source=\"{{ if .container }}{{ .container }}{{ else if eq .transport \\\"kernel\\\" }}kernel{{ else if .unit }}{{ .unit }}{{ else }}other{{ end }}\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
