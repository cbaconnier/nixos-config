      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sort_desc(sum by (source) (bytes_over_time({host=~\"$host\"} | label_format source=\"{{ if .container }}{{ .container }}{{ else if eq .transport \\\"kernel\\\" }}kernel{{ else if .unit }}{{ .unit }}{{ else }}other{{ end }}\" [$__range])))",
          "legendFormat": "{{source}}",
          "queryType": "instant"
