      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({host=~\"$host\", unit=\"syncthing.service\", level=~\"$level\"} |~ \"(?i)$search\" [$__range]))",
