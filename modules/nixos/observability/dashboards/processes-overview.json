    {
      "id": 5,
      "type": "table",
      "title": "Top processes now (CPU)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(15, sum by (host, groupname) (rate(namedprocess_namegroup_cpu_seconds_total{host=~\"$host\", groupname=~\"$process\", groupname=~\"(?i).*$search.*\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host, groupname) (namedprocess_namegroup_memory_bytes{host=~\"$host\", groupname=~\"$process\", groupname=~\"(?i).*$search.*\", memtype=\"resident\"})",
          "refId": "B",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host, groupname) (namedprocess_namegroup_num_procs{host=~\"$host\", groupname=~\"$process\", groupname=~\"(?i).*$search.*\"})",
          "refId": "C",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "groupname",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "host 2": true,
              "host 3": true
            },
            "renameByName": {
              "groupname": "Process",
              "host 1": "Host",
              "Value #A": "CPU (cores)",
              "Value #B": "Memory",
              "Value #C": "Procs"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "CPU (cores)",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU (cores)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
