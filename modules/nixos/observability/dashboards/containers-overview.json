    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{name!=\"\"}, host)",
          "refId": "PrometheusVariableQueryEditor-host"
        },
        "definition": "label_values(container_last_seen{name!=\"\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "project",
        "label": "Compose project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{name!=\"\", host=~\"$host\"}, container_label_com_docker_compose_project)",
          "refId": "PrometheusVariableQueryEditor-project"
        },
        "definition": "label_values(container_last_seen{name!=\"\", host=~\"$host\"}, container_label_com_docker_compose_project)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{name!=\"\", host=~\"$host\", container_label_com_docker_compose_project=~\"$project\"}, name)",
          "refId": "PrometheusVariableQueryEditor-container"
        },
        "definition": "label_values(container_last_seen{name!=\"\", host=~\"$host\", container_label_com_docker_compose_project=~\"$project\"}, name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
