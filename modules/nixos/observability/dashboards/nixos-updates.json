{
  "uid": "nixos-updates",
  "title": "NixOS updates",
  "tags": [
    "nixos",
    "security"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nixos_nixpkgs_timestamp_seconds, host)",
          "refId": "v-host"
        },
        "definition": "label_values(nixos_nixpkgs_timestamp_seconds, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Hosts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(time() - max by (host, revision) (nixos_nixpkgs_timestamp_seconds{host=~\"$host\"})) / 86400",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (host) (nixos_channel_update_available{host=~\"$host\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "count by (host) (nixos_update_package{host=~\"$host\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "count by (host) (nixos_cve{scope=\"current\", host=~\"$host\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "count by (host) (nixos_cve{scope=\"current\", host=~\"$host\"} unless on (host, cve) nixos_cve{scope=\"updated\"} and on (host) nixos_update_preview_timestamp_seconds)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "F",
          "expr": "time() - max by (host) (nixos_update_preview_timestamp_seconds{host=~\"$host\"})",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "host": "Host",
              "revision": "nixpkgs revision",
              "Value #A": "nixpkgs age",
              "Value #B": "Newer channel",
              "Value #C": "Pending updates",
              "Value #D": "CVEs",
              "Value #E": "CVEs fixed by update",
              "Value #F": "Preview age"
            },
            "indexByName": {
              "host": 0,
              "Value #A": 1,
              "revision": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "nixpkgs age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "d"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 7
                    },
                    {
                      "color": "red",
                      "value": 14
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Newer channel"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no"
                      },
                      "1": {
                        "text": "yes"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Preview age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Pending updates",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "nixos_update_package{host=~\"$host\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "scope": true,
              "Value": true
            },
            "renameByName": {
              "host": "Host",
              "package": "Package",
              "from": "Running",
              "to": "After update",
              "size": "Size change"
            },
            "indexByName": {
              "host": 0,
              "package": 1,
              "from": 2,
              "to": 3,
              "size": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "CVEs fixed by updating",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "nixos_cve{scope=\"current\", host=~\"$host\"} unless on (host, cve) nixos_cve{scope=\"updated\"} and on (host) nixos_update_preview_timestamp_seconds",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "scope": true,
              "Value": false
            },
            "renameByName": {
              "host": "Host",
              "package": "Package",
              "version": "Version",
              "cve": "CVE",
              "Value": "CVSS"
            },
            "indexByName": {
              "host": 0,
              "package": 1,
              "version": 2,
              "cve": 3,
              "Value": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CVE"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "NVD",
                    "url": "https://nvd.nist.gov/vuln/detail/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CVSS"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 4
                    },
                    {
                      "color": "orange",
                      "value": 7
                    },
                    {
                      "color": "red",
                      "value": 9
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "CVSS",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "CVEs in the running system",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
