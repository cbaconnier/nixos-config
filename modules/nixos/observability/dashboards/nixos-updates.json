          },
          "refId": "A",
          "expr": "nixos_cve{scope=\"current\", host=~\"$host\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
